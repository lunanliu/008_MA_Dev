          <HDLType>std_logic</HDLType>
          <Direction>ToCLIP</Direction>
          <DataType>
            <Boolean />
          </DataType>
          <Description>NI-provided free-running 125 MHz; use this same clock for the SCTL</Description>
          <SignalType>clock</SignalType>
          <FreqInHertz>
            <Min>125000000</Min>
            <Max>125000000</Max>
          </FreqInHertz>
        </Signal>
