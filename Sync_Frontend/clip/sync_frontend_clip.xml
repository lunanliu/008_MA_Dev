          <HDLName>reset_n</HDLName>
          <HDLType>std_logic</HDLType>
          <Direction>ToCLIP</Direction>
          <DataType>
            <Boolean />
          </DataType>
          <Description>Active-low reset, hold at least 4 clocks, wait for input_ready after release</Description>
          <SignalType>data</SignalType>
          <RequiredClockDomain>clk125</RequiredClockDomain>
          <UseInLabVIEWSingleCycleTimedLoop>Required</UseInLabVIEWSingleCycleTimedLoop>
        </Signal>
        <Signal Name="session_start">
          <HDLName>session_start</HDLName>
          <HDLType>std_logic</HDLType>
          <Direction>ToCLIP</Direction>
          <DataType>
            <Boolean />
          </DataType>
          <Description>One clock pulse starts a new continuity epoch</Description>
          <SignalType>data</SignalType>
          <RequiredClockDomain>clk125</RequiredClockDomain>
          <UseInLabVIEWSingleCycleTimedLoop>Required</UseInLabVIEWSingleCycleTimedLoop>
        </Signal>
        <Signal Name="session_abort">
          <HDLName>session_abort</HDLName>
          <HDLType>std_logic</HDLType>
          <Direction>ToCLIP</Direction>
          <DataType>
            <Boolean />
          </DataType>
