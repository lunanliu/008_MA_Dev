<?xml version='1.0' encoding='utf-8'?>
<CLIPDeclaration Name="Autonomous TO CFO frontend 125MHz FLGB">
  <FormatVersion>4.3</FormatVersion>
  <Description>Raw-IQ autonomous capture, coarse TO/CFO and fine TO. Single clock. Finite queue; not sustained ADC or board qualified.</Description>
  <TopLevelEntityAndArchitecture>
    <SynthesisModel>
      <Entity>sync_frontend_clip</Entity>
      <Architecture>rtl</Architecture>
    </SynthesisModel>
  </TopLevelEntityAndArchitecture>
  <SupportedDeviceFamilies>Unlimited</SupportedDeviceFamilies>
