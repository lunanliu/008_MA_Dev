        </Signal>
        <Signal Name="input_data3">
          <HDLName>input_data3</HDLName>
          <HDLType>std_logic_vector(31 downto 0)</HDLType>
          <Direction>ToCLIP</Direction>
          <DataType>
            <U32 />
          </DataType>
